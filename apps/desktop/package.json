{
  "name": "tsagent-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "npm run typecheck && node scripts/run-ts-test.mjs tests/localAgentServiceClient.test.ts tests/clientFactory.test.ts tests/runController.test.ts tests/runControllerOperations.test.ts",
    "test:local-client": "node scripts/run-ts-test.mjs tests/localAgentServiceClient.test.ts",
    "test:desktop4a": "node scripts/run-ts-test.mjs tests/clientFactory.test.ts",
    "test:desktop4b1": "node scripts/run-ts-test.mjs tests/runController.test.ts",
    "test:desktop4b2": "node scripts/run-ts-test.mjs tests/runControllerOperations.test.ts",
    "test:desktop4c": "node scripts/run-ts-test.mjs tests/desktop4cE2EHarness.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.1",
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  }
}

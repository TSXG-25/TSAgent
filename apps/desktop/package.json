{
  "name": "tsagent-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "VITE_TSAGENT_SIDECAR_CWD=\"$PWD/../..\" VITE_TSAGENT_SIDECAR_CMD=\"$PWD/../../.venv/bin/python\" tauri dev",
    "build": "tsc -b && vite build",
    "test:desktop4c": "node scripts/run-ts-test.mjs tests/desktop4cE2EHarness.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:orbits": "node scripts/test-orbits.mjs",
    "test:scenes": "node scripts/test-scenes.mjs",
    "test:sidecar-e2e": "node scripts/test-sidecar-e2e.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xyflow/react": "12.12.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.9.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.18.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.1",
    "@types/three": "^0.186.0",
    "esbuild": "0.27.7",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
